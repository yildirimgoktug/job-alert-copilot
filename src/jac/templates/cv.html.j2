<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ identity.name }} - CV</title>
<style>
  @page { size: A4; margin: 10mm 13mm 9mm 13mm; }
  :root { --ink:#1b2130; --muted:#586173; --navy:#1f3a5f; --link:#1f4e8c; }
  * { box-sizing: border-box; }
  html, body { margin:0; padding:0; background:#fff; }
  body { font-family: "Calibri", "Carlito", "Lato", "Segoe UI", sans-serif; color:var(--ink); font-size:9.35pt; line-height:1.24; }
  a { color:var(--link); text-decoration:none; }
  header { margin-bottom:4pt; }
  .top { display:flex; justify-content:space-between; align-items:flex-end; gap:12pt; }
  h1 { font-size:21pt; letter-spacing:0.4pt; color:var(--navy); margin:0; font-weight:700; line-height:1.05; text-transform:uppercase; }
  .tagline { font-size:10.1pt; margin-top:2pt; }
  .contact { color:var(--muted); font-size:9.1pt; text-align:right; line-height:1.35; }
  h2 { font-size:10.2pt; color:var(--navy); text-transform:uppercase; letter-spacing:0.5pt; margin:6.5pt 0 3pt 0; padding-bottom:1pt; border-bottom:1.1pt solid var(--navy); font-weight:700; }
  p { margin:0 0 2pt 0; }
  .entry { margin:0 0 4pt 0; break-inside:avoid; }
  .row { display:flex; justify-content:space-between; align-items:baseline; gap:10pt; }
  .role { font-weight:700; }
  .date { color:var(--muted); white-space:nowrap; font-size:9.1pt; }
  .sub { font-style:italic; color:var(--muted); font-size:9.1pt; margin:0 0 1pt 0; }
  .meta { color:var(--muted); font-size:8.9pt; }
  ul { margin:1pt 0 0 0; padding-left:11.5pt; }
  li { margin:0 0 1.2pt 0; }
  .proj { margin:0 0 3.2pt 0; break-inside:avoid; }
  table.skills { width:100%; border-collapse:collapse; }
  table.skills td { vertical-align:top; padding:0 0 1.6pt 0; }
  table.skills td:first-child { width:13%; font-weight:700; padding-right:6pt; white-space:nowrap; }
</style>
</head>
<body>
<header>
  <div class="top">
    <div><h1>{{ identity.name }}</h1></div>
    <div class="contact">{{ contact_html }}</div>
  </div>
  {% if identity.headline %}<div class="tagline">{{ identity.headline }}</div>{% endif %}
</header>

{% if summary %}<h2>Profile</h2>
<p>{{ summary | rich }}</p>{% endif %}

{% if education %}<h2>Education</h2>
{% for fact in education %}<div class="entry">
  <div class="row"><div><span class="role">{{ fact.title }}</span>{% if fact.org %}, {{ fact.org }}{% endif %}</div><div class="date">{{ fact.dates }}</div></div>
  {% for b in fact.bullets %}<div>{{ b.text | rich }}</div>{% endfor %}
</div>{% endfor %}{% endif %}

{% if experience %}<h2>Experience</h2>
{% for fact in experience %}<div class="entry">
  <div class="row"><div><span class="role">{{ fact.title }}</span>{% if fact.org %} · {{ fact.org }}{% endif %}</div><div class="date">{{ fact.dates }}</div></div>
  {% if fact.summary %}<div class="sub">{{ fact.summary | rich }}{% if fact.link %} <a href="{{ fact.link }}">{{ fact.link | replace("https://", "") }}</a>{% endif %}</div>{% endif %}
  <ul>{% for b in fact.bullets %}<li>{{ b.text | rich }}</li>{% endfor %}</ul>
</div>{% endfor %}{% endif %}

{% if projects %}<h2>Projects</h2>
{% for fact in projects %}<div class="proj"><span class="role">{{ fact.title }}</span>
  <span class="meta">{% if fact.team %}· {{ fact.team }} {% endif %}{% if fact.tags %}· {{ fact.tags | join(", ") }} {% endif %}{% if fact.link %}· <a href="{{ fact.link }}">{{ fact.link | replace("https://", "") }}</a>{% endif %}</span><br>
  {% for b in fact.bullets %}{{ b.text | rich }} {% endfor %}
</div>{% endfor %}{% endif %}

{% if publications %}<h2>Publications</h2>
{% for fact in publications %}<div class="proj">{% for b in fact.bullets %}{{ b.text | rich }} {% endfor %}{% if fact.link %}<a href="{{ fact.link }}">{{ fact.link | replace("https://", "") }}</a>{% endif %}</div>{% endfor %}{% endif %}

{% if skills %}<h2>Skills</h2>
<table class="skills">
{% for group in skills %}  <tr><td>{{ group.name }}</td><td>{{ group.items | join(", ") }}</td></tr>
{% endfor %}</table>{% endif %}
</body>
</html>
